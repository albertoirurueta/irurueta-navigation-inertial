<?xml version="1.0"?>
<!--
  SpotBugs exclusion filter for irurueta-navigation-inertial.

  Policy: only bug patterns that flag intentional, documented design decisions of this
  library are excluded here, each scoped to the library's own packages and justified by
  its own rationale comment. Every other pattern (e.g. MC_OVERRIDABLE_METHOD_CALL_IN_CLONE,
  DM_DEFAULT_ENCODING) is fixed in code instead of being excluded (see issue #49).
-->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

  <!-- Constructors validate arguments through setters by design (see issue #49). -->
  <Match>
    <Package name="~com\.irurueta\.navigation\.inertial(\..*)?"/>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>

  <!-- Numerical APIs share Matrix/array/collection instances on purpose to avoid copies. -->
  <Match>
    <Package name="~com\.irurueta\.navigation\.inertial(\..*)?"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
